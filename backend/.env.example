# Copy to .env and fill in real values. .env is gitignored -- never commit real keys.

ANVESHAK_TRONGRID_API_KEY=
ANVESHAK_ETHERSCAN_API_KEY=

# Used only for the officer-facing narrative-summary feature (app/narrative/).
# Narrates already-computed, already-verified findings into plain English -- never used
# for detection/attribution/risk decisions, which stay rule-based per this project's own
# "label scarcity" design thesis (see CLAUDE.md). Optional: the feature is skipped
# honestly (not faked) when this is unset.
ANVESHAK_OPENAI_API_KEY=

# Officer login (email+OTP via E:/API's Lighthouse Auth API) -- shared-secret JWT
# verification only, this backend never issues a token itself.
# MUST be set to the EXACT SAME VALUE as E:/API's own JWT_SECRET (see E:/API/.env.example),
# or every officer login will silently fail verification with a generic 401.
ANVESHAK_AUTH_JWT_SECRET=
