VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000
# E:/API (Lighthouse Auth API) -- separate FastAPI process from the KAIZEN backend above.
# KAIZEN's own backend already owns :8000 (VITE_API_BASE_URL), and E:/API's own README also
# defaults to :8000, so run E:/API locally with `--port 8001` to avoid the collision:
#   cd E:\API && .venv\Scripts\python.exe -m uvicorn app.main:app --reload --port 8001
VITE_AUTH_API_URL=http://localhost:8001
