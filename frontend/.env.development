VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000
# Login used to also need VITE_AUTH_API_URL for E:/API's Lighthouse Auth API (separate FastAPI
# repo, real email+OTP officer sign-in). That flow was retired in favour of an instant, no-
